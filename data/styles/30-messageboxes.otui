MessageBoxBodyCip < UILabel
  font: Verdana Bold-11px-new
  color: #c0c0c0ff
  text-align: center

MessageBoxWindow < UIMessageBox
  icon-rect: 4 4 16 16
  size: 246 116
  image-source: /images/ui/window-high
  image-border: 20
  &minimizedHeight: 17
  anchors.centerIn: parent
  draggable: false

  $on:
    image-border-bottom: 2

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 3
    margin-left: 3
    margin-top: 2
    height: 18
    phantom: true

  Label
    id: title
    font: $var-cip-font
    text-offset: 0 0
    text-align: top
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    color: #909090
    text-offset: 0 1

  MessageBoxBodyCip
    id: content
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    text-wrap: true
    text-auto-resize: true
    margin-top: 29

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: content.bottom
    margin-top: 11
    margin-right: 16
    margin-left: 16

  UIWidget
    id: holder
    anchors.right: prev.right
    anchors.left: prev.left
    anchors.top: prev.bottom
    anchors.bottom: parent.bottom
    margin-top: 11

ModalHigh < UIMessageBox
  size: 765 117
  image-source: /images/ui/window-high
  image-border: 10
  &minimizedHeight: 17
  anchors.centerIn: parent
  draggable: false

  $on:
    image-border-bottom: 2

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 3
    margin-left: 3
    margin-top: 2
    height: 18
    phantom: true

  Label
    id: title
    font: $var-cip-font-new
    text-offset: 0 0
    text-align: center
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    opacity: 0.5

  UIWidget
    id: holder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 26
    margin-bottom: 10
    text-offset: 0 -1
    margin-right: 6

  HorizontalSeparator
    id: modalHighSep
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: holder.top
    margin-left: 16
    margin-right: 16
    margin-bottom: 11

  MessageBoxBodyCip
    id: content
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: modalHighSep.top
    margin-top: 4
    margin-left: 15
    margin-right: 18
    margin-bottom: 3
    text-wrap: true
    text-align: left

ImbueSuccessInfoModal < UIMessageBox
  size: 410 104
  image-source: /images/ui/window-high
  image-border: 10
  &minimizedHeight: 17
  anchors.centerIn: parent
  draggable: false

  $on:
    image-border-bottom: 2

  UIWidget
