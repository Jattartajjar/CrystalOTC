    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 3
    margin-left: 3
    margin-top: 2
    height: 18
    phantom: true

  Label
    id: title
    font: $var-cip-font-new
    text-offset: 0 0
    text-align: center
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    margin-top: 0
    opacity: 0.5

  UIWidget
    id: holder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 26
    margin-bottom: 14

  HorizontalSeparator
