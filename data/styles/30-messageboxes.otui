  MessageBoxBodyCip
    id: content
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: imbueSuccessSep.top
    margin-top: 4
    margin-left: 12
    margin-right: 12
    margin-bottom: 4
    text-wrap: true
    text-align: center

